{
  "name": "@ngwes/skill-be",
  "version": "1.4.1",
  "description": "A CLI that benchmarks Agent Skills: baseline versus with-skill, LLM-graded and gated, on any harness.",
  "keywords": [
    "agent-skills",
    "skill-md",
    "claude-code",
    "claude-skills",
    "llm",
    "evals",
    "llm-evaluation",
    "llm-as-a-judge",
    "benchmark",
    "release-gate",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngwes/skill-be.git"
  },
  "homepage": "https://ngwes.github.io/skill-be/",
  "bugs": {
    "url": "https://github.com/ngwes/skill-be/issues"
  },
  "bin": {
    "skill-be": "dist/cli.js"
  },
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "author": "ngwes",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@ngwes/mini-fp": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.9.9",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
